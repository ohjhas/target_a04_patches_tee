# Multi-TEE init.rc script
# Support multiple firmware versions, mainly used to add support for all variants
# while running latest available firmware
# - Check the model and if the bootloader is supported via ro.boot.bootloader
# - If it is a known version it is mounted and boot process continues normally

# Credits to @salvogiangri for the initial version of this script
# Modified TEE Blobs Patch for Galaxy A04, credits to Fede2782 and salvogiangri.

# SM-A045F
on early-fs && property:ro.boot.em.model=SM-A045F && property:ro.boot.bootloader=A045FXXSCEYJ2
    # TEEgris
    mount none /vendor/tee_f /vendor/tee bind

# SM-A045M
on early-fs && property:ro.boot.em.model=SM-A045M && property:ro.boot.bootloader=A045MUBSDEYJ1
    # TEEgris
    mount none /vendor/tee_m /vendor/tee bind
